/-- The integer numerator of `c_j`; `0` outside `16 ≤ j ≤ 16380`. -/
def coeffInt (j : ℕ) : ℤ := if 16 ≤ j ∧ j ≤ 16380 then coeffList.getD (j - 16) 0 else 0

/-- The window`s coefficient `c_j = coeffInt j / 10 ^ coeffScale`. -/
noncomputable def coeff (j : ℕ) : ℝ := (coeffInt j : ℝ) / 10 ^ coeffScale

