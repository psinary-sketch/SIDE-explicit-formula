theorem nf_ok_A : natChk 1 nfA = true := by decide +kernel

theorem nf_len_A : nfA.length = 3278 := by decide +kernel

theorem nf_ok_B : natChk 3279 nfB = true := by decide +kernel

theorem nf_len_B : nfB.length = 3278 := by decide +kernel

theorem nf_ok_C : natChk 6557 nfC = true := by decide +kernel

theorem nf_len_C : nfC.length = 3278 := by decide +kernel

theorem nf_ok_D : natChk 9835 nfD = true := by decide +kernel

theorem nf_len_D : nfD.length = 3278 := by decide +kernel

theorem nf_ok_E : natChk 13113 nfE = true := by decide +kernel

theorem nf_len_E : nfE.length = 3278 := by decide +kernel

/-- The factorization of `m`, read from its run. -/
def nfac (m : ℕ) : List (ℕ × ℕ) :=
  if m < 3279 then natAt nfA (m - 1) else
  if m < 6557 then natAt nfB (m - 3279) else
  if m < 9835 then natAt nfC (m - 6557) else
  if m < 13113 then natAt nfD (m - 9835) else
  natAt nfE (m - 13113)

/-- Each `m` from 1 to 16,390: its factors` product is `m`, each factor a key of the primes` tree below 16,391. -/
theorem nfac_spec (m : ℕ) (h1 : 1 ≤ m) (h2 : m ≤ 16390) :
    facProd (nfac m) = m ∧ lpTree.facOK 16391 (nfac m) = true := by
  unfold nfac
  split_ifs with hA hB hC hD
  · have h := natChk_spec nfA 1 (m - 1) nf_ok_A (by rw [nf_len_A]; omega)
    rwa [show 1 + (m - 1) = m by omega] at h
  · have h := natChk_spec nfB 3279 (m - 3279) nf_ok_B (by rw [nf_len_B]; omega)
    rwa [show 3279 + (m - 3279) = m by omega] at h
  · have h := natChk_spec nfC 6557 (m - 6557) nf_ok_C (by rw [nf_len_C]; omega)
    rwa [show 6557 + (m - 6557) = m by omega] at h
  · have h := natChk_spec nfD 9835 (m - 9835) nf_ok_D (by rw [nf_len_D]; omega)
    rwa [show 9835 + (m - 9835) = m by omega] at h
  · have h := natChk_spec nfE 13113 (m - 13113) nf_ok_E (by rw [nf_len_E]; omega)
    rwa [show 13113 + (m - 13113) = m by omega] at h

